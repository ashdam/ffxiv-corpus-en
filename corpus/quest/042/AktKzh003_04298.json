    {
      "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_021",
      "en": "Isn't it fun watching them romp around?",
      "hash": "2511DF47594EFDFD",
      "unresolved": false,
      "fr": "Ça y est, tu les as attrapées<nbsp>?",
