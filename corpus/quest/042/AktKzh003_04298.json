    },
    {
      "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_023",
      "en": "These babies are aquatic creatures by nature, but we're modifying them to adapt to life on land.",
      "hash": "F2CDC643184740DF",
      "unresolved": false,
      "fr": "Ce sont à l'origine des créatures aquatiques, mais à l'institut Mitron, nous avons décidé de les modifier pour leur permettre de vivre également sur la terre.",
      "ja": "ゼピュロス72号の幼体はね、もとは海洋生物だったんだよ。<br>それを、陸地でも生息できるよう改良できないかと、<br>ミトロン院で創られたものなんだ！",
      "jaMacro": "ゼピュロス72号の幼体はね、もとは海洋生物だったんだよ。<br>それを、陸地でも生息できるよう改良できないかと、<br>ミトロン院で創られたものなんだ！",
      "conversation": "quest/042/AktKzh003_04298",
      "seq": 31,
      "speaker": "OBSERVERB04298",
      "speakerKind": "character",
      "speakerGender": "unknown",
      "kind": "dialogue",
      "questId": "AktKzh003_04298",
      "questName": "Naughty Little Ones",
      "section": "Sidequests",
      "category": "Elpis Sidequests",
      "genre": "Elpis Sidequests",
      "previousQuest": "AktKme112_04430",
      "sortKey": 5120,
