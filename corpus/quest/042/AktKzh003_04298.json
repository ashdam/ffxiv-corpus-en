    {
      "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_003",
      "en": "You can find my associate at Rumination's Ramble.",
      "hash": "41EAA6896D07D9DE",
      "unresolved": false,
      "fr": "Mon collègue est sur les bords du Péripatéticien, à l'est d'ici. Dis-lui de venir me rejoindre dès que possible, s'il te plaît.",
