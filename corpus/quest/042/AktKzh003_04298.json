    {
      "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_022",
      "en": "And they really seemed to like you! Do you work with young ones often?",
      "hash": "1261CDC68AC48140",
      "unresolved": false,
      "fr": "Merci. Tu t'es bien débrouillé<if(gnum4,e,)>. On dirait qu'elles t'apprécient.",
      "ja": "君は幼体の扱いに長けた使い魔なんだね！<br>みんなを連れてきてくれて、ありがとう。",
      "frMacro": "Merci. Tu t'es bien débrouillé<if(gnum4,e,)>. On dirait qu'elles t'apprécient.",
      "jaMacro": "君は幼体の扱いに長けた使い魔なんだね！<br>みんなを連れてきてくれて、ありがとう。",
      "conversation": "quest/042/AktKzh003_04298",
      "seq": 30,
      "speaker": "OBSERVERB04298",
      "speakerKind": "character",
      "speakerGender": "unknown",
      "kind": "dialogue",
      "questId": "AktKzh003_04298",
      "questName": "Naughty Little Ones",
      "section": "Sidequests",
