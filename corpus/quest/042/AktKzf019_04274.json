    {
      "gameKey": "quest/042/AktKzf019_04274#TEXT_AKTKZF019_04274_VISHRAHD_000_002",
      "en": "What're you standing around for? Are you going to leave those poor creatures to starve to death? Get to work! Chop-chop!",
      "hash": "69CBB4B041F84419",
      "unresolved": false,
      "fr": "Pas la peine de prendre cet air surpris<nbsp>! Allez, au travail<nbsp>!",
      "ja": "なーに驚いたような顔してやがる。<br>作業が押してるんだ、早々に動かねえとよ。<br>可愛いハンサたちが、腹ァ空かせて待ってんだから。",
      "frMacro": "Pas la peine de prendre cet air surpris<nbsp>! Allez, au travail<nbsp>!",
      "jaMacro": "なーに驚いたような顔してやがる。<br>作業が押してるんだ、早々に動かねえとよ。<br>可愛いハンサたちが、腹ァ空かせて待ってんだから。",
      "conversation": "quest/042/AktKzf019_04274",
      "seq": 4,
      "speaker": "VISHRAHD",
      "speakerKind": "character",
      "speakerGender": "male",
      "kind": "dialogue",
      "questId": "AktKzf019_04274",
