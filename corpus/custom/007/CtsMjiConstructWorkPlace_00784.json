    {
      "gameKey": "custom/007/CtsMjiConstructWorkPlace_00784#TEXT_CTSMJICONSTRUCTWORKPLACE_00784_SYSTEM_000_200",
      "en": "This appears to be a log with a board attached to it. How quaint.",
