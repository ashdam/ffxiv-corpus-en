    {
      "gameKey": "BaseParam#19.2",
      "en": "Affects the amount of physical and magic damage dealt and received, as well as HP restored. The higher the value, the more damage dealt, the more HP restored, and the less damage taken. Only applicable when role is Tank.",
      "hash": "13D7C535E77A1366",
      "unresolved": false,
      "fr": "Influence les dégâts infligés et subis par les attaques physiques et magiques ainsi que les PV restaurés. Une valeur élevée augmente les dégâts infligés ainsi que les PV restaurés, et réduit les dégâts subis. Applicable uniquement aux classes/jobs de tanks.",
      "ja": "物理・魔法攻撃により与えるダメージ量や回復量と、自身が受けるダメージ量に影響を与えます。\r\n不屈が高いほど与えるダメージ量と回復量が増加し、自身が受けるダメージ量が減少します。\r\n「Tank」ロールにのみ効果を発揮します。",
      "jaMacro": "物理・魔法攻撃により与えるダメージ量や回復量と、自身が受けるダメージ量に影響を与えます。<br>不屈が高いほど与えるダメージ量と回復量が増加し、自身が受けるダメージ量が減少します。<br>「Tank」ロールにのみ効果を発揮します。",
      "conversation": "BaseParam#19",
      "seq": 2,
      "speakerKind": "unknown",
      "kind": "ambient",
      "sheet": "BaseParam"
    },
    {
      "gameKey": "BaseParam#20.1",
      "en": "Attack Power",
      "hash": "F720BEFB7A5A0696",
      "unresolved": false,
      "fr": "Attaque",
      "ja": "物理攻撃力",
      "conversation": "BaseParam#20",
      "seq": 1,
      "speakerKind": "unknown",
      "kind": "ambient",
      "sheet": "BaseParam"
    },
    {
      "gameKey": "BaseParam#20.2",
      "en": "Affects amount of damage dealt by physical attacks. The higher the value, the more damage dealt.",
      "hash": "2DBD71A0D4262110",
      "unresolved": false,
      "fr": "Influence le montant de dégâts infligés par les attaques physiques.",
      "ja": "物理攻撃によるダメージ量に影響を与えます。\r\n物理攻撃力が高いほど、物理攻撃で与えるダメージが大きくなります。",
      "jaMacro": "物理攻撃によるダメージ量に影響を与えます。<br>物理攻撃力が高いほど、物理攻撃で与えるダメージが大きくなります。",
      "conversation": "BaseParam#20",
      "seq": 2,
      "speakerKind": "unknown",
      "kind": "ambient",
      "sheet": "BaseParam"
    },
    {
      "gameKey": "BaseParam#21.1",
      "en": "Defense",
      "hash": "A4D2D9D27604F1FB",
      "unresolved": false,
      "fr": "Défense",
      "ja": "物理防御力",
      "conversation": "BaseParam#21",
      "seq": 1,
      "speakerKind": "unknown",
      "kind": "ambient",
      "sheet": "BaseParam"
    },
    {
      "gameKey": "BaseParam#21.2",
      "en": "Affects the amount of damage taken by physical attacks. The higher the value, the less damage taken.",
      "hash": "32A52C6C58EDECC0",
      "unresolved": false,
      "fr": "Influence le montant de dégâts reçus lorsqu'une attaque physique est subie. Une défense élevée permet de subir moins de dégâts.",
      "ja": "物理攻撃を受けた際のダメージを軽減します。\r\n物理防御力が高いほど、物理攻撃によって受けるダメージが小さくなります。",
      "jaMacro": "物理攻撃を受けた際のダメージを軽減します。<br>物理防御力が高いほど、物理攻撃によって受けるダメージが小さくなります。",
      "conversation": "BaseParam#21",
      "seq": 2,
      "speakerKind": "unknown",
      "kind": "ambient",
      "sheet": "BaseParam"
    },
    {
      "gameKey": "BaseParam#22.1",
      "en": "Direct Hit Rate",
      "hash": "BEF8EE86262AD39C",
      "unresolved": false,
      "fr": "Coups nets",
      "ja": "ダイレクトヒット",
      "conversation": "BaseParam#22",
