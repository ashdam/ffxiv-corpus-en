    {
      "gameKey": "GoldSaucerTextData#62",
      "en": "Step upon the main stage and memorize the routine for the big dance number.",
      "hash": "A02D0C58F2FF6196",
      "unresolved": false,
      "fr": "Montez sur scène et exécutez les pas de danse adéquats pour briller lors de la représentation\u00A0!",
      "ja": "ステージの上で、特訓に備えよ\r\n使用するエモートをよく確認すべし",
      "frMacro": "Montez sur scène et exécutez les pas de danse adéquats pour briller lors de la repré<->sen<->ta<->tion<nbsp>!",
      "jaMacro": "ステージの上で、特訓に備えよ<br>使用するエモートをよく確認すべし",
      "conversation": "GoldSaucerTextData#62",
      "seq": 0,
      "speakerKind": "unknown",
      "kind": "ambient",
      "sheet": "GoldSaucerTextData"
    },
    {
      "gameKey": "GoldSaucerTextData#63",
      "en": "Memorize the routine of the Lords and Ladies of the Dance and flawlessly perform on cue ten moves or more.",
      "hash": "5DA7F609BA7D6CB1",
      "unresolved": false,
      "fr": "Mémorisez plus de dix emotes et effectuez-les dans le bon ordre pour devenir la nouvelle étoile\u00A0!",
      "ja": "ダンスマスターの動きを暗記して\r\n合図に合わせ、順番通りにエモートを実行せよ\r\n10回以上、エモートを模倣できれば合格だ",
      "frMacro": "Mémorisez plus de dix emotes et effectuez-les dans le bon ordre pour devenir la nouvelle étoile<nbsp>!",
      "jaMacro": "ダンスマスターの動きを暗記して<br>合図に合わせ、順番通りにエモートを実行せよ<br>10回以上、エモートを模倣できれば合格だ",
      "conversation": "GoldSaucerTextData#63",
      "seq": 0,
      "speakerKind": "unknown",
      "kind": "ambient",
      "sheet": "GoldSaucerTextData"
    },
