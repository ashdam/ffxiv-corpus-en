  "entries": [
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000010_GAIA",
      "en": "I'm drawing out the Darkness. Get ready!",
      "hash": "378E3D05CFEFB796",
      "unresolved": false,
      "fr": "Préparez-vous, j'appelle les Ténèbres\u00A0!",
      "ja": "疑似妖異召喚……開始するわ！",
      "frMacro": "Préparez-vous, j'appelle les Ténèbres<nbsp>!",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 0,
      "speaker": "GAIA",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000020_RYNE",
      "en": "It worked, Gaia! We've done it!",
      "hash": "4364868516E1DAAD",
      "unresolved": false,
      "fr": "Bravo Gaïa, tu as réussi\u00A0!",
      "ja": "やったねガイア、成功したよ！",
      "frMacro": "Bravo Gaïa, tu as réussi<nbsp>!",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 1,
      "speaker": "RYNE",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000030_RYNE",
      "en": "So this all took place a hundred years ago...",
      "hash": "906AFEB60AA631C4",
      "unresolved": false,
      "fr": "Une bataille vieille d'un siècle...",
      "ja": "100年前の戦いの再現……",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 2,
      "speaker": "RYNE",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000040_RYNE",
      "en": "But what does it have to do with Gaia?",
      "hash": "8A66BE3D0ECDCE21",
      "unresolved": false,
      "fr": "Mais quel rapport... avec les souvenirs de Gaïa...\u00A0?",
      "ja": "ガイアの記憶と、どう関係が……？",
      "frMacro": "Mais quel rapport... avec les souvenirs de Gaïa...<nbsp>?",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 3,
      "speaker": "RYNE",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000050_RYNE",
      "en": "I know this place...! It's the gaol in Eulmore!",
      "hash": "BB2E501B4A50ECBA",
      "unresolved": false,
      "fr": "Je reconnais cet endroit... C'est la prison d'Eulmore\u00A0!?",
      "ja": "これは……ユールモアの監獄棟！？",
      "frMacro": "Je reconnais cet endroit... C'est la prison d'Eulmore<nbsp>!?",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 4,
      "speaker": "RYNE",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000060_RYNE",
      "en": "Whatever stands in our way...",
      "hash": "110276C3593B06E0",
      "unresolved": false,
      "fr": "Peu importe ce qui se dresse sur notre route...",
      "ja": "たとえ何が立ちふさがろうとも……",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 5,
      "speaker": "RYNE",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000070_RYNE",
      "en": "...we will never give up hope!",
      "hash": "19366ED8C2C40ADC",
      "unresolved": false,
      "fr": "Jamais on ne perdra espoir\u00A0!",
      "ja": "絶対に希望を捨てません！",
      "frMacro": "Jamais on ne perdra espoir<nbsp>!",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 6,
      "speaker": "RYNE",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000080_EDEN3BOSS3",
      "en": "She deserves...all the happiness...in the world...",
      "hash": "C5A6CB59793DA188",
      "unresolved": false,
      "fr": "Je ne souhaiterai jamais rien d'autre que ton bonheur...",
      "ja": "我が娘の征く明日に  祝福を……",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 7,
      "speaker": "EDEN3BOSS3",
      "speakerKind": "character",
      "speakerGender": "unknown",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000090_EDEN3BOSS4",
      "en": "Eden will become a utopia...",
      "hash": "7534593E01460C5B",
      "unresolved": false,
      "fr": "Éden sera l'ultime utopie...",
      "ja": "二度と分かたれることのないよう……。",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 8,
      "speaker": "EDEN3BOSS4",
      "speakerKind": "character",
      "speakerGender": "unknown",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000100_EDEN3BOSS4",
      "en": "One that we may share for all eternity.",
      "hash": "991BA113F7B501E2",
      "unresolved": false,
      "fr": "Que nous partagerons pour l'éternité\u00A0!",
      "ja": "エデンを真なる理想郷に……！",
      "frMacro": "Que nous partagerons pour l'éternité<nbsp>!",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 9,
      "speaker": "EDEN3BOSS4",
      "speakerKind": "character",
      "speakerGender": "unknown",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000110_RYNE",
      "en": "She's still in there, somewhere...",
      "hash": "BDF0C57278417B5D",
      "unresolved": false,
      "fr": "Sa conscience... Elle est toujours là, quelque part...",
      "ja": "まだ、彼女の意識は残っているはず……",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 10,
      "speaker": "RYNE",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000120_RYNE",
      "en": "I won't give up on our future, Gaia! No matter what!",
      "hash": "DE791688CA0EFF4B",
      "unresolved": false,
      "fr": "Gaïa... tiens bon\u00A0! Je ne renoncerai pas à notre avenir\u00A0!",
      "ja": "必ず、一緒に明日を迎えよう……ガイア……！",
      "frMacro": "Gaïa... tiens bon<nbsp>! Je ne renoncerai pas à notre avenir<nbsp>!",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 11,
      "speaker": "RYNE",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000130_EDEN3BOSS4",
      "en": "Our utopia... Our dream!",
      "hash": "447FE07482C27677",
      "unresolved": false,
      "fr": "Notre utopie... Notre rêve...\u00A0!",
      "ja": "刻が……流れていく……！",
      "frMacro": "Notre utopie... Notre rêve...<nbsp>!",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 12,
      "speaker": "EDEN3BOSS4",
      "speakerKind": "character",
      "speakerGender": "unknown",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    },
    {
      "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000140_EDEN3BOSS5",
      "en": "I...shall...return...",
      "hash": "77C4DB2BDCFB9420",
      "unresolved": false,
      "fr": "Dans un autre corps... Dans une autre vie...",
      "ja": "いつかまた転生し……そして……",
      "conversation": "cut_scene/054/VoiceMan_05401",
      "seq": 13,
      "speaker": "EDEN3BOSS5",
      "speakerKind": "character",
      "speakerGender": "unknown",
      "kind": "dialogue",
      "sheet": "cut_scene/054/VoiceMan_05401"
    }
  ]
