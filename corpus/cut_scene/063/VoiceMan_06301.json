      "gameKey": "cut_scene/063/VoiceMan_06301#TEXT_VOICEMAN_06301_000005_NOPHICA",
      "en": "At last, the time is come!",
      "hash": "895FCE372A21FF52",
      "unresolved": false,
      "fr": "Le moment est enfin arrivé<nbsp>!",
      "ja": "ああ  とうとうこのときが来た……！",
      "de": "Ah, sie sind gekommen. Endlich ist es so weit!",
      "conversation": "cut_scene/063/VoiceMan_06301",
      "seq": 0,
      "speaker": "NOPHICA",
      "speakerKind": "character",
      "speakerGender": "female",
