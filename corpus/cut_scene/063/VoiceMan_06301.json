    },
    {
      "gameKey": "cut_scene/063/VoiceMan_06301#TEXT_VOICEMAN_06301_000030_MENPHINA",
      "en": "Come bathe in the moon's tender glow!",
      "hash": "CD17BDD7BBF59CA5",
      "unresolved": false,
      "fr": "À nous, mes enfants bien-aimés<nbsp>!",
      "ja": "さあ  月神の愛で満たしてあげる！",
      "de": "Und nun, empfangt die Liebe des Mondes!",
      "conversation": "cut_scene/063/VoiceMan_06301",
      "seq": 1,
      "speaker": "MENPHINA",
      "speakerKind": "character",
      "speakerGender": "female",
      "kind": "dialogue",
      "sheet": "cut_scene/063/VoiceMan_06301"
    },
    {
      "gameKey": "cut_scene/063/VoiceMan_06301#TEXT_VOICEMAN_06301_000040_MENPHINA",
      "en": "Our dreams may yet become reality. Thank you.",
      "hash": "FBBD8B4AF12891AB",
      "unresolved": false,
      "fr": "Merci infiniment. Nous voilà encore un peu plus proches de notre idéal...",
      "ja": "ありがとう<br>また一歩  切なる願いへ近づけた――",
      "de": "Danke. Ich bin meinem Traum einen Schritt näher gekommen.",
      "conversation": "cut_scene/063/VoiceMan_06301",
