    {
      "gameKey": "cut_scene/065/VoiceMan_06501#TEXT_VOICEMAN_06501_000010_OSCHON",
      "en": "The will of the star has entrusted the future to you and yours.",
      "hash": "A3C7EFAB43538C25",
      "unresolved": false,
      "fr": "L'avenir d'Ætherys sera bientôt entre vos mains...",
      "ja": "星の意志は  今の人に未来を託した――",
      "conversation": "cut_scene/065/VoiceMan_06501",
      "seq": 0,
      "speaker": "OSCHON",
      "speakerKind": "character",
      "speakerGender": "male",
      "kind": "dialogue",
      "sheet": "cut_scene/065/VoiceMan_06501"
    },
    {
      "gameKey": "cut_scene/065/VoiceMan_06501#TEXT_VOICEMAN_06501_000020_OSCHON",
      "en": "As entities charged with ensuring life on Etheirys, we rejoice in this outcome with all our hearts.",
      "hash": "28C68B517B8B99EE",
      "unresolved": false,
      "fr": "Ainsi en a décidé la volonté de la planète, et aucun dénouement ne pourrait plus nous ravir...",
      "ja": "アーテリスを補強するシステムとして<br>その結末を  俺たちがどんなに喜んだことか",
      "jaMacro": "アーテリスを補強するシステムとして<br>その結末を  俺たちがどんなに喜んだことか",
      "conversation": "cut_scene/065/VoiceMan_06501",
      "seq": 1,
      "speaker": "OSCHON",
      "speakerKind": "character",
      "speakerGender": "male",
      "kind": "dialogue",
      "sheet": "cut_scene/065/VoiceMan_06501"
    },
    {
      "gameKey": "cut_scene/065/VoiceMan_06501#TEXT_VOICEMAN_06501_000030_THETWELVE",
      "en": "'Tis time, beloved children. Time to bid farewell to we relics of the past.",
      "hash": "03D91A3A9D9ED7A9",
      "unresolved": false,
      "fr": "Nos très chers enfants... L'heure est venue de nous dire adieu...",
      "ja": "愛しき人の子ら――<br>どうか旧き人の欠片に  はなむけを――",
      "jaMacro": "愛しき人の子ら――<br>どうか旧き人の欠片に  はなむけを――",
